<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.gradescopespringboot.mapper.UserRoleMapper">

    <select id="selectByUserId" resultType="com.example.gradescopespringboot.entity.UserRole">
        SELECT
            id,
            user_id,
            role_id,
            created_at
        FROM user_roles
        WHERE user_id = #{userId}
    </select>

    <insert id="insert"
            parameterType="com.example.gradescopespringboot.entity.UserRole"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO user_roles (
            user_id,
            role_id
        ) VALUES (
            #{userId},
            #{roleId}
        )
    </insert>

    <delete id="deleteByUserId">
        DELETE FROM user_roles
        WHERE user_id = #{userId}
    </delete>

</mapper>
